{
	"name": "opencode-go-copilot-provider",
	"publisher": "OnesoftQwQ",
	"displayName": "OpenCode Go Provider for Copilot",
	"description": "Integrate OpenCode Go models into GitHub Copilot Chat",
	"icon": "assets/logo.png",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-models",
		"llm",
		"opencode",
		"openai-compatible",
		"thinking",
		"git-commit"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/OnesoftQwQ/opencode-go-copilot"
	},
	"homepage": "https://github.com/OnesoftQwQ/opencode-go-copilot",
	"bugs": {
		"url": "https://github.com/OnesoftQwQ/opencode-go-copilot/issues"
	},
	"version": "1.7.8",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Chat"
	],
	"license": "MIT",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "opencodego",
				"displayName": "%providerDisplayName%",
				"managementCommand": "opencodego.setApiKey"
			}
		],
		"commands": [
			{
				"command": "opencodego.setApiKey",
				"category": "%commandCategory%",
				"title": "%command.setApiKey%"
			},
			{
				"command": "opencodego.getApiKey",
				"category": "%commandCategory%",
				"title": "%command.getApiKey%"
			},
			{
				"command": "opencodego.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "opencodego.generateGitCommitMessage",
				"title": "%command.generateCommit%",
				"category": "%commandCategory%",
				"icon": "$(wand)"
			},
			{
				"command": "opencodego.abortGitCommitMessage",
				"title": "%command.abortCommit%",
				"category": "%commandCategory%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "opencodego.setModelPreset",
				"category": "%commandCategory%",
				"title": "%command.setModelPreset%"
			},
			{
				"command": "opencodego.updateModelList",
				"category": "%commandCategory%",
				"title": "%command.updateModelList%"
			}
		],
		"walkthroughs": [
			{
				"id": "opencodeGoGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:opencodego.setApiKey"
						]
					},
					{
						"id": "showModels",
						"title": "%walkthrough.showModels.title%",
						"description": "%walkthrough.showModels.description%",
						"media": {
							"markdown": "resources/walkthrough/show-models.md"
						}
					},
					{
						"id": "advancedSettings",
						"title": "%walkthrough.advancedSettings.title%",
						"description": "%walkthrough.advancedSettings.description%",
						"media": {
							"markdown": "resources/walkthrough/advanced-settings.md"
						}
					}
				]
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "opencodego.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !opencodego.isGeneratingCommit"
				},
				{
					"command": "opencodego.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && opencodego.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "opencodego.generateGitCommitMessage",
					"when": "config.git.enabled && !opencodego.isGeneratingCommit"
				},
				{
					"command": "opencodego.abortGitCommitMessage",
					"when": "config.git.enabled && opencodego.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"opencodego.commitLanguage": {
					"type": "string",
					"default": "auto",
					"enum": [
						"auto",
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"enumDescriptions": [
						"%config.commitLanguage.auto.desc%",
						"%config.commitLanguage.enum.English.desc%",
						"%config.commitLanguage.enum.French.desc%",
						"%config.commitLanguage.enum.Italian.desc%",
						"%config.commitLanguage.enum.German.desc%",
						"%config.commitLanguage.enum.Spanish.desc%",
						"%config.commitLanguage.enum.Russian.desc%",
						"%config.commitLanguage.enum.ChineseSimplified.desc%",
						"%config.commitLanguage.enum.ChineseTraditional.desc%",
						"%config.commitLanguage.enum.Japanese.desc%",
						"%config.commitLanguage.enum.Korean.desc%",
						"%config.commitLanguage.enum.Czech.desc%",
						"%config.commitLanguage.enum.PortugueseBrazil.desc%",
						"%config.commitLanguage.enum.Turkish.desc%",
						"%config.commitLanguage.enum.Polish.desc%"
					],
					"description": "%config.commitLanguage.desc%"
				},
				"opencodego.commitModel": {
					"type": "string",
					"default": "deepseek-v4-flash",
					"description": "%config.commitModel.desc%"
				},
				"opencodego.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "%config.commitMessagePrompt.desc%"
				},
				"opencodego.requestTimeout": {
					"type": "number",
					"default": 600000,
					"minimum": 10000,
					"description": "%config.requestTimeout.desc%"
				},
				"opencodego.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"markdownDescription": "%config.delay.desc%"
				},
				"opencodego.retry.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.retry.enabled.desc%"
				},
				"opencodego.retry.max_attempts": {
					"type": "number",
					"default": 3,
					"minimum": 1,
					"maximum": 10,
					"description": "%config.retry.maxAttempts.desc%"
				},
				"opencodego.retry.interval_ms": {
					"type": "number",
					"default": 1000,
					"minimum": 0,
					"description": "%config.retry.intervalMs.desc%"
				},
				"opencodego.retry.status_codes": {
					"type": "array",
					"items": {
						"type": "integer",
						"minimum": 100,
						"maximum": 599
					},
					"uniqueItems": true,
					"default": [],
					"description": "%config.retry.statusCodes.desc%"
				},
				"opencodego.recentCommitsCount": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"maximum": 50,
					"description": "%config.recentCommitsCount.desc%"
				},
				"opencodego.commitIncludeCommitDiff": {
					"type": "boolean",
					"default": false,
					"description": "%config.commitIncludeCommitDiff.desc%"
				},
				"opencodego.commitAttachContextFiles": {
					"type": "boolean",
					"default": true,
					"description": "%config.commitAttachContextFiles.desc%"
				},
				"opencodego.modelPreset": {
					"type": "string",
					"default": "precise",
					"description": "%config.modelPreset.desc%",
					"editPresentation": "singlelineText"
				},
				"opencodego.temperature": {
					"type": "number",
					"default": null,
					"minimum": 0,
					"maximum": 2,
					"description": "%config.temperature.desc%"
				},
				"opencodego.top_p": {
					"type": "number",
					"default": null,
					"minimum": 0,
					"maximum": 1,
					"description": "%config.top_p.desc%"
				},
				"opencodego.enableZenFreeModels": {
					"type": "boolean",
					"default": false,
					"description": "%config.enableZenFreeModels.desc%"
				},
				"opencodego.enableAutoModelDiscovery": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableAutoModelDiscovery.desc%"
				},
				"opencodego.showDeprecatedModels": {
					"type": "boolean",
					"default": false,
					"description": "%config.showDeprecatedModels.desc%"
				},
				"opencodego.modelsDevUpdateInterval": {
					"type": "number",
					"default": 60000,
					"minimum": 30000,
					"description": "%config.modelsDevUpdateInterval.desc%"
				},
				"opencodego.modelPresets": {
					"type": "array",
					"default": [
						{
							"id": "precise",
							"label": "Precise",
							"temperature": 0
						},
						{
							"id": "balanced",
							"label": "Balanced",
							"temperature": 1
						},
						{
							"id": "creative",
							"label": "Creative",
							"temperature": 1.2
						},
						{
							"id": "extra-creative",
							"label": "Extra Creative",
							"temperature": 1.7
						}
					],
					"items": {
						"type": "object",
						"required": [
							"id",
							"label",
							"temperature"
						],
						"properties": {
							"id": {
								"type": "string",
								"description": "%config.modelPreset.id.desc%"
							},
							"label": {
								"type": "string",
								"description": "%config.modelPreset.label.desc%"
							},
							"temperature": {
								"type": "number",
								"description": "%config.modelPreset.temperature.desc%"
							},
							"top_p": {
								"type": "number",
								"description": "%config.modelPreset.top_p.desc%"
							}
						}
					},
					"description": "%config.modelPresets.desc%"
				},
				"opencodego.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"markdownDescription": "%config.readFileLines.desc%"
				},
				"opencodego.visionProxyModel": {
					"type": "string",
					"default": "qwen3.6-plus",
					"description": "%config.visionProxyModel.desc%"
				},
				"opencodego.visionProxyThinking": {
					"type": "boolean",
					"default": false,
					"description": "%config.visionProxyThinking.desc%"
				},
				"opencodego.enableThirdPartyTokenIndicator": {
					"type": "boolean",
					"default": true,
					"description": "%config.enableThirdPartyTokenIndicator.desc%"
				},
				"opencodego.httpAllowInsecure": {
					"type": "boolean",
					"default": false,
					"description": "%opencodego.config.httpAllowInsecure%"
				},
				"opencodego.visionMaxRounds": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 20,
					"markdownDescription": "%config.visionMaxRounds.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"test:vision-history": "npm run compile && node scripts/test-vision-history.mjs",
		"lint": "eslint",
		"watch": "tsc -watch -p ./",
		"build": "npx @vscode/vsce package -o extension.vsix",
		"postinstall": "node scripts/copy-tokenizer.js"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "9.39.4",
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"eslint": "9.39.4",
		"typescript": "^5.9.2",
		"typescript-eslint": "8.60.1"
	}
}